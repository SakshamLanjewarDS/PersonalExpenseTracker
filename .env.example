# PocketPlan Environment Configuration

# Next.js Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Service Role Key (Used strictly for server-side administrative jobs/migrations)
# NEVER expose this on the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push Notification VAPID Keys
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:admin@pocketplan.local

# Cron Job Secret (for protecting /api/notifications/cron and scheduled tasks)
CRON_SECRET=your-secure-cron-secret-token

# App Details
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
